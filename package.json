{
  "name": "wms",
  "version": "0.1.0",
  "private": true,
  "description": "Warehouse Management System — Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "wrangler d1 execute wms-db --remote --file=./schema.sql",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute wms-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute wms-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute wms-db --file=./seed.sql",
    "db:seed:local": "wrangler d1 execute wms-db --local --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
